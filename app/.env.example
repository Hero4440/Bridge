# app/.env.example — committed template. Copy to .env (gitignored) and fill in locally:
#   cp .env.example .env
#
# NOTE: SKILL.md prefers NO .env. AWS credentials belong in ~/.aws/credentials, and
# deployed app secrets belong in Amplify (`npx ampx sandbox secret set NAME`).
# This template exists only so a teammate knows which local vars may be set. Never
# commit a real .env.

# AWS (the CLI/ampx actually read ~/.aws, not this file — reference only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Phase 2 (fill after enabling Bedrock in the console)
BEDROCK_MODEL_ID=

# Made-up Cognito accounts used only by the real demo-data seed script.
# Keep the values local and use example.com addresses so no real person receives mail.
BRIDGE_DEMO_SAM_EMAIL=
BRIDGE_DEMO_SAM_PASSWORD=
BRIDGE_DEMO_JORDAN_EMAIL=
BRIDGE_DEMO_JORDAN_PASSWORD=
